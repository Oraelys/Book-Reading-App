# Copy to .env.development / .env.staging / .env.production (all git-ignored).
# Read by the Electron MAIN process only. The renderer never sees these values.
#
# electron-vite loads .env.[mode]:
#   npm run dev            -> .env.development
#   npm run build:staging  -> .env.staging
#   npm run build          -> .env.production

# Inkwell NestJS backend (no trailing slash needed). https required outside localhost.
MAIN_VITE_INKWELL_API_URL=https://book-reading-app-ugts.onrender.com

# Supabase project URL + ANON (public) key. The anon key is designed to be public,
# same as the mobile app. NEVER put the service-role key here or anywhere in this app.
MAIN_VITE_SUPABASE_URL=https://ltckgjskuaafliazvxma.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx0Y2tnanNrdWFhZmxpYXp2eG1hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI1MjgwNTAsImV4cCI6MjA3ODEwNDA1MH0.VZaOPScbYpxkoQTDa0oBMimv8_D9aTNqLMh3IXcHG6Q

# Label shown in the UI header: development | staging | production
